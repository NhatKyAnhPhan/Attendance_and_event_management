PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=QL_SuKienDA
# Aiven CA path: ./ca.pem locally, or /etc/secrets/ca.pem on Render.
DB_SSL_CA=./ca.pem
JWT_SECRET=<random-secret-at-least-32-bytes>
PASSWORD_RESET_SECRET=<different-random-secret-at-least-32-bytes>
# Set this to /etc/secrets/<uploaded-secret-filename> in Render.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Alternative: paste the full JSON into this environment variable instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HUIT <noreply@example.com>"
# Set MAIL_PROVIDER to smtp, resend, or brevo.
MAIL_PROVIDER=smtp
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM="HUIT <noreply@example.com>"
PUBLIC_API_BASE_URL=http://IP_MÁY_TÍNH:3000
# Optional on Linux/macOS when a Vietnamese-capable system font is not installed.
CERTIFICATE_FONT_PATH=
